# 把这份复制成 .env 再改
#   cp .env.example .env

# ---- 对外端口 ----
PORT=8000

# ---- 数据库（compose 里的 postgres 容器）----
DB_USER=dewu
DB_PASSWORD=请改成你自己的强密码
DB_NAME=dewu

# ---- 管理员账号 ----
# 留空 = 首次启动随机生成一个，写到 webdata/ADMIN_PASSWORD.txt，并在日志里打印
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- 会话 ----
# 留空 = 首次启动自动生成并存到 webdata/secret.key（容器重启也不会掉线）
SECRET_KEY=

# ---- 得物活动 ----
# 活动换批次后拉列表会报「活动不存在」，改这里
DEWU_ACTIVITY=20260917

# ---- 开放策略 ----
# 是否允许新的得物账号首次登录（0 = 只允许已存在的账号登）
ALLOW_NEW_USER=1
# 用户数上限，0 = 不限
MAX_USERS=0
# 创建任务是否必须填兑换码（一码一任务）
REQUIRE_CODE_FOR_TASK=1
