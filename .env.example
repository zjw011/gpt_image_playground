# 复制本文件为 .env 后修改（放在项目根目录），docker compose 会自动读取。
# .env 已被 .gitignore 忽略，不会误提交。

# 宿主机对外端口，容器内固定 8080。
GIP_PORT=8080

# 只有 Node 服务位于你控制的 Nginx/Caddy 等反向代理之后时才改成 1。
# 直连公网必须保持 0，否则客户端可伪造代理头绕过登录、注册和兑换限流。
GIP_TRUST_PROXY=0

# 公网生图保护：全站同时最多 30 个任务；单账号/IP 同时最多 2 个；每分钟最多提交 12 次。
# 按服务器配置和上游额度调整，但不建议直接关闭。
GIP_GENERATION_GLOBAL_CONCURRENCY=30
GIP_GENERATION_USER_CONCURRENCY=2
GIP_GENERATION_PER_MINUTE=12

# 更新容器时等待正在生图的请求完成，避免用户任务被部署强行中断。
GIP_SHUTDOWN_GRACE_SECONDS=120

# 站长账号（role=admin）。登录入口和普通用户是同一个，登录后自动进管理后台。
# 账号仅在「还不存在」时创建；已经在后台改过密码的，这里的值不会再覆盖它。
# 密码至少 6 位。想改密码：登录后在后台「访问与安全」页改。
#
# ⚠️ 密码故意留空，首次部署前必须填写自己的强密码；留空不会自动创建站长账号。
#    它是唯一能进后台管理渠道和用户的账号，建议至少 12 位并混合字母、数字和符号。
GIP_ADMIN_USER=admin
GIP_ADMIN_PASSWORD=

# 逃生门：设为 1 时，启动会强制把上面账号的密码重置成 GIP_ADMIN_PASSWORD 的值
# （同名账号已存在但密码对不上、或账号被别人注册走了，用它拿回来）。
# 用完记得改回 0 或删掉，否则每次重启都会把密码顶回环境变量里的值。
GIP_ADMIN_PASSWORD_RESET=0

# 共享访客口令，至少 6 个字符。设置后自动切到「共享口令」访问模式。
# 留空则保持开放访问：任何能访问到这个地址的人都能用你配置的渠道生图。
# 想给每个人单独开账号（数据互相隔离）就不用填这个，进后台「用户」页创建账号后切到多用户模式。
# 后台的访客口令和用户口令都能一键随机生成，不用自己想。
GIP_GUEST_PASSWORD=

# ---------------------------------------------------------------------------
# 渠道、访问方式、积分与卡密都不在这里配——它们存在数据目录的
# config.json 里，启动后进后台改（用站长账号登录即进后台）。后台改完立即生效，不用重启容器。
#
# 普通用户注册走「邮箱验证码」：需要先在后台「邮件发信」页把 SMTP 配好，
# 没配好之前注册页会明确提示、发不出验证码。微信登录还没上线，后台只有占位入口。
# ---------------------------------------------------------------------------
