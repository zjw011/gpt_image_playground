# 复制本文件为 .env 后修改（放在项目根目录），docker compose 会自动读取。
# .env 已被 .gitignore 忽略，不会误提交。

# 宿主机对外端口，容器内固定 8080。
GIP_PORT=8080

# 管理员口令，至少 8 个字符。仅在首次启动（还没设过口令）时生效。
# 留空则改为首次访问 /admin 时在页面上设置。
GIP_ADMIN_PASSWORD=

# 共享访客口令，至少 8 个字符。设置后自动切到「共享口令」访问模式。
# 留空则保持开放访问：任何能访问到这个地址的人都能用你配置的渠道生图。
# 想给每个人单独开账号（数据互相隔离）就不用填这个，进后台「用户」页创建账号后切到多用户模式。
GIP_GUEST_PASSWORD=
