# 复制本文件为 .env 后修改（放在项目根目录），docker compose 会自动读取。
# .env 已被 .gitignore 忽略，不会误提交。

# 宿主机对外端口，容器内固定 8080。
GIP_PORT=8080

# 管理员口令，至少 8 个字符。仅在首次启动（还没设过口令）时生效。
# 留空则改为首次访问 /admin 时在页面上设置。
GIP_ADMIN_PASSWORD=

# 共享访客口令，至少 6 个字符。设置后自动切到「共享口令」访问模式。
# 留空则保持开放访问：任何能访问到这个地址的人都能用你配置的渠道生图。
# 想给每个人单独开账号（数据互相隔离）就不用填这个，进后台「用户」页创建账号后切到多用户模式。
# 后台的访客口令和用户口令都能一键随机生成，不用自己想。
GIP_GUEST_PASSWORD=

# ---------------------------------------------------------------------------
# 渠道、访问方式、积分与卡密、公众号登录都不在这里配——它们存在数据目录的
# config.json 里，启动后进 /admin 后台改。后台改完立即生效，不用重启容器。
#
# 想让用户用微信扫码关注公众号登录，或者想按张扣积分，去 /admin 的
# 「微信登录」和「积分与卡密」两页。公众号那边需要你把后台给出的回调地址
# （形如 https://你的域名/api/wechat/callback）和 Token / EncodingAESKey
# 填到公众号后台的「服务器配置」里，详见 docs/self-hosted-backend.md。
# ---------------------------------------------------------------------------
