# ---------------- 大文件 / 构建产物（不进仓库） ----------------
_apk/
build/
build_new/
dist/
dist_new/
*.apk
*.exe
#
# spec 例外：build_exe.py 是「读」spec 而不是生成 spec 的，
# 仓库里没有它就跑不了打包；而且 hiddenimports=['dewu_proxies','socks']
# 就在里面 —— 少了这行，打出来的 exe 一开 socks 代理就报
# "Missing dependencies for SOCKS support"。所以这个文件必须入库。
*.spec
!得物整点抢兑助手.spec
*.png
*.jpg
*.jpeg
*.gif
*.ico
# app.ico 同样要入库：spec 里 datas=[(app.ico,'.')] + icon=['app.ico'] 都指着它，
# 缺了它就打不了包（或打出来任务栏是系统默认图标）。161KB，值。
!app.ico
#
# 加群二维码：用户端设置页「公告 · 库存实时监听」直接 <img src="/qr_group.png"> 引它。
# 42KB，缺了就是一张裂图，所以必须入库（静态资源一律跟着代码走）。
!webapp/static/qr_group.png
icon_src/

# ---------------- 运行期数据（含账号 token，绝不入库） ----------------
accounts.json
tasks.json
watch_state.json
config.json
device.json
dewu_sniper.log
*.log
data/
*.db
*.sqlite3

# web 版本地数据
webdata/

# ---------------- 逆向/调试临时件 ----------------
_reverse_login/
tools/_*
tools/diag/_*
tools/__pycache__/
__pycache__/
*.py[cod]

# ---------------- 环境 ----------------
.venv/
venv/
env/
.env
.env.local

# ---------------- 编辑器 ----------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
